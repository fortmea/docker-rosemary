# Fragmento de configuração do kernel para Docker no rosemary (LineageOS, kernel 4.19).
# Aplicado sobre rosemary_defconfig por kernel/build.sh. Cada linha é testada no aparelho.

# --- Obrigatórias: ausentes no kernel padrão do LineageOS (o instalador do módulo recusa sem elas)
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- Recomendadas
# --cpus / --cpu-quota
CONFIG_CFS_BANDWIDTH=y
# userns-remap e imagens que criam user namespaces
CONFIG_USER_NS=y
# redes IPv6 com NAT (daemon.json "ipv6": true)
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
# driver de rede macvlan
CONFIG_MACVLAN=y
# imagens com systemd e afins
CONFIG_FHANDLE=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CGROUP_NET_PRIO=y
